# 共用設定（所有專家共用）。憑證不要寫這裡，寫在 private/experts/<name>/.env

# ── 模型供應商 ────────────────────────────────────
# aimlapi（OpenAI 相容）：需要 provider + base_url + api_mode
HERMES_MODEL=deepseek/deepseek-chat
HERMES_PROVIDER=openai-api
HERMES_BASE_URL=https://api.aimlapi.com/v1
# aimlapi 的 deepseek 只在 /v1/chat/completions 提供，Hermes 預設走 /v1/responses 會 400
HERMES_API_MODE=chat_completions
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.aimlapi.com/v1

# 官方 DeepSeek（若不用 aimlapi 可改回這個，並清空上面四行）
# DEEPSEEK_API_KEY=

# ── 飛書（海外版 lark / 中國版 feishu）─────────────
FEISHU_DOMAIN=lark
FEISHU_CONNECTION_MODE=websocket
FEISHU_GROUP_POLICY=open

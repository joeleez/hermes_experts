# ── 專家實例資料：永不進 git ────────────────────────
private/*
!private/.gitkeep

# ── 秘密 ────────────────────────────────────────
.env
.env.*
!.env.example

# ── 執行產物 ──────────────────────────────────────
*.tar.gz
*.log
data/

# ── 系統檔 ────────────────────────────────────────
.DS_Store
Thumbs.db
private/groups.yaml
projects/*
!projects/.gitkeep
